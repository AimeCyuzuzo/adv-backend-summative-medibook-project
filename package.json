{
  "name": "medibook",
  "version": "1.0.0",
  "description": "MediBook clinic appointment booking API",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "logs": "sh scripts/watch-audit.sh",
    "test": "jest",
    "db:schema": "sh scripts/db.sh schema",
    "db:seed": "sh scripts/db.sh seed",
    "db:reset": "sh scripts/db.sh reset",
    "db:drop": "sh scripts/db.sh drop",
    "db:shell": "sh scripts/db.sh shell",
    "queue:reset": "docker compose exec -T redis redis-cli FLUSHDB"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=18"
  }
}
