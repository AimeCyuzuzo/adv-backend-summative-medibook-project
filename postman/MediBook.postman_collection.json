{
  "info": {
    "name": "MediBook API",
    "description": "Requests for every MediBook endpoint, in demo order.\n\nBefore running: `npm run db:reset && npm run queue:reset`, then `npm start` and `npm run worker` (two terminals).\nRun the whole collection with the Collection Runner, or click through requests top to bottom:\nlater requests use ids saved by earlier ones, and the appointment/waitlist folders change data.\n\nDates ({{busyDay}}, {{freeDay}}, …) are computed automatically in Kigali time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "yesterday",
      "value": ""
    },
    {
      "key": "busyDay",
      "value": ""
    },
    {
      "key": "freeDay",
      "value": ""
    },
    {
      "key": "newPatientId",
      "value": ""
    },
    {
      "key": "newDoctorId",
      "value": ""
    },
    {
      "key": "appointmentId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const DAY = 24 * 60 * 60 * 1000;",
          "const kigaliDate = (offsetDays) => new Date(Date.now() + 2 * 60 * 60 * 1000 + offsetDays * DAY).toISOString().slice(0, 10);",
          "pm.collectionVariables.set('today', kigaliDate(0));",
          "pm.collectionVariables.set('yesterday', kigaliDate(-1));",
          "pm.collectionVariables.set('busyDay', kigaliDate(2));   // seed: Dr. Boateng has 11/12 booked",
          "pm.collectionVariables.set('freeDay', kigaliDate(10));  // nobody booked → clean slate for demos"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
